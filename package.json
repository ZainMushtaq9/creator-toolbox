{
  "name": "creator-toolbox",
  "version": "0.1.0",
  "private": true,
  "description": "CreatorToolbox — free tools for creators. Deliverable A (frontend + backend skeleton).",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "sitemap": "node scripts/generate-sitemap.js",
    "validate:metadata": "node scripts/validate-metadata.js",
    "validate:links": "node scripts/validate-links.js",
    "manifest": "node scripts/build-route-manifest.js",
    "test": "node --test tests/unit/services.test.mjs tests/security/fetch.test.mjs tests/seo/seo.test.mjs",
    "test:backend": "npm --prefix backend test",
    "test:e2e": "node --test tests/e2e/smoke.test.mjs",
    "test:all": "npm test && npm run test:backend && npm run test:e2e"
  },
  "type": "module",
  "devDependencies": {
    "playwright-core": "^1.64.1"
  }
}
