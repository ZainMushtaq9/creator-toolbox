# CreatorToolbox — environment configuration EXAMPLE (placeholders ONLY).
# Copy to .env (frontend) / .dev.vars (Worker local dev) and fill in real
# values. NEVER commit a file with real secrets. .env and .dev.vars are
# git-ignored. Secrets for production are set with `wrangler secret put NAME`.

# --- Public site ---
SITE_URL=https://YOUR-DOMAIN
VITE_API_URL=https://YOUR-WORKER-URL

# --- Analytics / ads (placeholders only — replace from your accounts) ---
# GA4 measurement ID. Leave G-XXXXXXXXXX until you have a real one.
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# AdSense publisher ID. NEVER deploy the placeholder to ads.txt.
ADSENSE_PUBLISHER_ID=pub-YOUR-PUBLISHER-ID

# --- AI provider: Cloudflare Workers AI (DEFAULT — no key needed) ---
# Native binding env.AI.run(...) — set in backend/wrangler.toml as
#   [ai] binding = "AI"
# No key, no card, no new account. Free limit: 10,000 Neurons/day per
# account, recurring FOREVER, resets 00:00 UTC. Overage on the Free plan
# stops with an error. Models: @cf/meta/llama-4-scout-17b-16e-instruct
# (131K served context), embeddings @cf/baai/bge-m3 (1024-dim).
# Without the AI binding (e.g. local node --test), AI endpoints return
# a labelled dev mock — NOT production-connected.
# Optional per-task model overrides:
# WORKERS_AI_MODEL_SEOANALYSIS=@cf/meta/llama-4-scout-17b-16e-instruct
# AI_PROVIDER=workers-ai   # or "gemini" | "anyrouter" | "groq" | "nvidia"

# --- AI provider: Google AI Studio / Gemini (LONG-CONTEXT OVERFLOW only) ---
# Used ONLY when input exceeds the Workers AI window (131K tokens).
# Model gemini-2.5-flash, up to 1M tokens context. Free tier, no card.
# Create a key at https://aistudio.google.com, then:
#   npx wrangler secret put GEMINI_API_KEY
# Exact free-tier RPM/RPD are NOT published by Google — do not invent
# a number; check the AI Studio rate-limit page. Free-tier prompts may
# be used by Google to improve its products — never send sensitive data.
# NOT CONNECTED until the owner supplies this key.
GEMINI_API_KEY=

# --- AI providers: OPTIONAL FALLBACKS only (never the default) ---
# Hugging Face Inference Providers (router.huggingface.co/v1, OpenAI-
# compatible, CHAT ONLY; embeddings via the feature-extraction API).
# Free HF accounts get ZERO included Inference Providers credits — calls
# need purchased credits, PRO ($9/mo for $2 credits), or a BYOK upstream
# key in HF settings. Models: openai/gpt-oss-120b:fastest (131K ctx);
# long-context deepseek-ai/DeepSeek-V4.1-Flash:fastest (1,048,576 ctx);
# embeddings BAAI/bge-m3. Gated Llama models are NOT wired.
# Token: a FRESH fine-grained token with ONLY "Make calls to Inference
# Providers" permission. NEVER reuse the 2026-11-04 chat-shared HF token
# (exposed), and keep it separate from the PSX project's token:
#   npx wrangler secret put HF_API_TOKEN
HF_API_TOKEN=
# AnyRouter (anyrouter/free, sk-ar-v1-…): free plan is only a 5-request
# LIFETIME trial; then Go $2/mo (Polar $2.63) for $4/mo credits, or free
# Go by donating an eligible BYOK key (DeepSeek, Z.ai GLM, Moonshot Kimi).
#   npx wrangler secret put ANYROUTER_API_KEY
ANYROUTER_API_KEY=
# Groq (openai/gpt-oss-120b, gsk_…): free, no card; 30 RPM, 1,000 req/day,
# 200,000 tokens/day; no embeddings.
#   npx wrangler secret put GROQ_API_KEY
GROQ_API_KEY=
# NVIDIA Build (OPTIONAL FALLBACK only, trial-only terms, nvapi-…).
# Never reuse another project's key. Never commit a key.
NVIDIA_API_KEY=
# NVIDIA_MODEL_SEOANALYSIS=

# --- Google Search Console (Phase 5, owner property only) ---
# Create OAuth credentials in Google Cloud Console (web application type),
# set the redirect URI to https://<worker>/api/v1/gsc/callback, then:
#   npx wrangler secret put GOOGLE_CLIENT_ID
#   npx wrangler secret put GOOGLE_CLIENT_SECRET
#   npx wrangler secret put OAUTH_ENCRYPTION_KEY
# Scope is read-only: https://www.googleapis.com/auth/webmasters.readonly
# With no credentials configured, Search Console is labelled NOT CONNECTED.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_ENCRYPTION_KEY=

# --- Admin (owner-only SEO Intelligence + private API endpoints) ---
# A long random token. Set as a Worker secret, never in code:
#   npx wrangler secret put ADMIN_TOKEN
# With no ADMIN_TOKEN configured, all private endpoints return 401 (locked).
ADMIN_TOKEN=

# --- Cloudflare D1 (Phase 4 deployment step) ---
# Create with: npx wrangler d1 create creator_toolbox
# Paste the real database_id into backend/wrangler.toml.
D1_DATABASE_ID=REPLACE_WITH_REAL_D1_DATABASE_ID
